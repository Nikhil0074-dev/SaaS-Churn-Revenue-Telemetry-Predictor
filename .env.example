# Copy to .env (never commit the real file). All values below are placeholders.
APP_ENV=development                       # development | production (production enforces a strong JWT_SECRET)

# SQLite is the zero-setup default. PostgreSQL for docker-compose / production:
DATABASE_URL=sqlite:///./churn_dev.db
# DATABASE_URL=postgresql+psycopg://churn:CHANGE_ME@localhost:5432/churn_db

# Session signing key: at least 32 random characters in production, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Stripe (use TEST-mode keys; leave empty to run with CSV import / demo data)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=                   # not used by the backend; reserved for a future checkout/portal UI

# Directory for versioned model artifacts (joblib). Created on first training run.
MODEL_ARTIFACT_DIR=./ml/artifacts

CORS_ORIGINS=http://localhost:5173        # comma-separated list of allowed browser origins

# Rate limits (requests per minute)
INGEST_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
HEAVY_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_TOLERANCE_SECONDS=300

# docker-compose only
POSTGRES_PASSWORD=
